[Unit]
Description=PS MCP service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mcp
Group=mcp
ExecStart=/opt/mcp/mcp-env/bin/python -m psmcp --env-file /opt/mcp/config/.env
Restart=on-failure
RestartSec=5
Environment="PYTHONUNBUFFERED=1"

[Install]
WantedBy=multi-user.target