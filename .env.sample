# =============================================================================
# PS-MCP Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values for your environment:
#   cp .env.sample .env
#
# Only the variables for routers you enable need to be set.
# Lines starting with # are comments and are ignored.
# =============================================================================

# -----------------------------------------------------------------------------
# Server Settings
# -----------------------------------------------------------------------------
MCP_TRANSPORT=http
MCP_HOST=0.0.0.0
MCP_PORT=8888
LOG_LEVEL=INFO

# SSL/TLS — enable HTTPS by providing paths to key and certificate files.
# Both must be set for SSL to activate. CLI flags --ssl-keyfile / --ssl-certfile
# take precedence over these env vars.
# MCP_SSL_KEYFILE=
# MCP_SSL_CERTFILE=

# Comma-separated list of routers to enable.
# Available: arcgis, developer_tools, dynamic_app, feature_service,
#            geoprocessing, location_services, mongo, postgres
# If not set, ALL installed routers are enabled by default.
ENABLED_ROUTERS=arcgis,feature_service,geoprocessing,location_services

# Optional: custom config directory for routers.json and other config files.
# Defaults to ~/.psmcp/ if not set.
# PSMCP_CONFIG_DIR=

# -----------------------------------------------------------------------------
# ArcGIS Connection  (required for: arcgis, dynamic_app, feature_service,
#                     geoprocessing, location_services routers)
# -----------------------------------------------------------------------------
# Base URL of your ArcGIS portal. Works with both ArcGIS Online and Enterprise.
# The URL is normalized automatically — trailing /sharing/rest is stripped.
#
# ArcGIS Online examples:
#   ARCGIS_PORTAL_URL=https://www.arcgis.com
#   ARCGIS_PORTAL_URL=https://myorg.maps.arcgis.com
#
# ArcGIS Enterprise examples:
#   ARCGIS_PORTAL_URL=https://gis.example.com/portal
#   ARCGIS_PORTAL_URL=https://portal.example.com:7443/arcgis
ARCGIS_PORTAL_URL=https://your-portal.domain.com/portal

# TLS certificate verification. Set to "false" for self-signed certs
# (Enterprise only — ArcGIS Online always uses valid public certs).
ARCGIS_VERIFY_SSL=True

# Optional: ArcGIS Server base URL for System services and REST endpoints.
# Defaults to {ARCGIS_PORTAL_URL}/server if not set.
# Use this when your Server has a different web adaptor context or host.
# Not applicable for ArcGIS Online.
# ARCGIS_SERVER_URL=https://your-server.domain.com/arcgis

# Optional: provide a default ArcGIS token (can also be passed per-request).
# Useful for development/testing without OAuth enabled.
# ARCGIS_TOKEN=

# -----------------------------------------------------------------------------
# Authentication — Choose ONE of the following modes:
# -----------------------------------------------------------------------------

# --- Option A: Legacy Token Passthrough (ArcGIS Enterprise only) ---
# Enables the ArcGIS auth provider that validates tokens against the portal.
# USE_ARCGIS_AUTH=True

# --- Option B: OAuth Proxy Mode (ArcGIS Online & Enterprise) ---
# Enables full OAuth 2.1 proxy — MCP clients authenticate via standard OAuth
# flows and the server proxies authorization to the upstream ArcGIS portal.
# This is the recommended mode for production deployments.
# USE_ARCGIS_OAUTH=true

# OAuth client credentials registered in your ArcGIS portal.
# For ArcGIS Online: create via App Registration in your org settings or
#   the developer dashboard.
# For Enterprise: add an "OAuth credentials" item in the portal.
# ARCGIS_OAUTH_CLIENT_ID=
# ARCGIS_OAUTH_CLIENT_SECRET=

# Public base URL of this MCP server (used for OAuth metadata and callbacks).
# Must be reachable by the MCP client's browser during the OAuth flow.
# MCP_SERVER_BASE_URL=http://localhost:8888

# Token verification cache TTL in seconds (default: 120).
# Verified tokens are cached in memory to avoid redundant portal round-trips.
# Set to 0 to disable caching entirely.
# ARCGIS_TOKEN_CACHE_TTL=120

# -----------------------------------------------------------------------------
# Location Services  (required for: location_services router)
# -----------------------------------------------------------------------------
# Optional: override the default geocode service URL.
# For ArcGIS Online, the World Geocoder is used by default.
# For Enterprise, set this to your organization's geocode service.
# ARCGIS_GEOCODE_SERVICE_URL=https://geocode.arcgis.com/arcgis/rest/services/World/GeocodeServer

# -----------------------------------------------------------------------------
# Geoprocessing  (required for: geoprocessing router)
# -----------------------------------------------------------------------------
# Optional: comma-separated default tags for filtering GP services in the catalog.
# Only services tagged with these values will appear in tool listings.
# GP_CATALOG_DEFAULT_TAGS=MCP,mcp

# -----------------------------------------------------------------------------
# LLM Map Generation  (optional, used by: arcgis, dynamic_app routers)
# -----------------------------------------------------------------------------
# Set USE_ARCGIS_LLM=true to enable LLM-powered map HTML generation.
# USE_ARCGIS_LLM=false

# OpenAI / Azure OpenAI settings (also shared with mongo and postgres routers)
# OPENAI_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o

# Azure OpenAI specific (set AZURE_OPENAI=true to use Azure client)
# AZURE_OPENAI=false
# AZURE_OPENAI_API_VERSION=2024-02-15-preview
# AZURE_OPENAI_DEPLOYMENT=gpt-4o

# -----------------------------------------------------------------------------
# MongoDB Vector Search  (required for: mongo router)
# -----------------------------------------------------------------------------
# MONGO_DB_CONN=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true
# MONGO_DB_NAME=your_database
# CONTEXT_COUNT=20
# CANDIDATES_MULTIPLIER=15

# Embedding model deployment name (Azure OpenAI)
# EMBEDDING_DEPLOYMENT=text-embedding-ada-002
# MONGO_OPENAI_BASE_URL=https://your-resource.openai.azure.com/
# MONGO_OPENAI_API_VERSION=2024-10-21

# -----------------------------------------------------------------------------
# PostgreSQL Vector Search  (required for: postgres router)
# -----------------------------------------------------------------------------
# POSTGRES_DB_CONN=postgresql://user:pass@host:5432/dbname
# POSTGRES_VECTOR_STORE_TABLE=your_table
# POSTGRES_CONTEXT_COUNT=20
# POSTGRES_VECTOR_STORE_ID_COLUMN=image_id
# POSTGRES_VECTOR_STORE_EMBEDDING_COLUMN=embedding
# POSTGRES_VECTOR_STORE_METADATA_COLUMNS=site_id,group_name,image_date,extent_xmin,extent_ymin,extent_xmax,extent_ymax
# POSTGRES_VECTOR_SEARCH_SCORE_THRESHOLD=0.4
# POSTGRES_VECTOR_SEARCH_MAX_ATTEMPTS=5

# Embedding model for PostgreSQL (defaults to text-embedding-3-small)
# POSTGRES_EMBEDDING_DEPLOYMENT=text-embedding-3-small
# POSTGRES_OPENAI_BASE_URL=https://your-resource.openai.azure.com/
# POSTGRES_OPENAI_API_VERSION=2024-10-21

# Optional: JSON array for multi-table config (overrides single-table vars above)
# POSTGRES_TABLES_CONFIG=[{"table":"tbl1","id_column":"id","embedding_column":"embedding","metadata_columns":["col1","col2"]}]

# -----------------------------------------------------------------------------
# Developer Tools  (required for: developer_tools router)
# -----------------------------------------------------------------------------
# JSON array of skill source configs. Each entry specifies a GitHub repo or
# local directory containing skill markdown documents.
# Example: [{"type":"github","url":"https://github.com/owner/repo"},{"type":"local","path":"/path/to/skills"}]
# DEVTOOLS_SKILL_SOURCES=

# JSON array of sample set configs. Each entry specifies a GitHub repo or
# local directory containing code samples, with optional language/API filters.
# Example: [{"type":"github","name":"my-samples","url":"https://github.com/owner/repo","languages":["python"],"apis":["arcgis"]}]
# DEVTOOLS_SAMPLE_SOURCES=

# GitHub personal access token for accessing private repositories.
# Required only if skill or sample sources reference private repos.
# GITHUB_TOKEN=

# Cache TTL in minutes for GitHub content (default: 60).
# DEVTOOLS_CACHE_TTL_MINUTES=60
